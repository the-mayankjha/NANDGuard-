#!/bin/bash

# NANDGuard+ Unified Build System (FkInstaller)
VERSION_FILE="VERSION"

# Initialize version file if it doesn't exist
if [ ! -f "$VERSION_FILE" ]; then
    echo "1.0.0" > "$VERSION_FILE"
fi

CURRENT_VERSION=$(cat "$VERSION_FILE" | xargs)

# Function to increment SemVer (patch version)
increment_version() {
    local v=$1
    IFS='.' read -r major minor patch <<< "$v"
    patch=$((patch + 1))
    echo "${major}.${minor}.${patch}"
}

if [[ "$1" == "build" && "$2" == "nandguard" ]]; then
    NEW_VERSION=$(increment_version "$CURRENT_VERSION")
    echo "------------------------------------------"
    echo "🚀 Building NANDGuard+ v${NEW_VERSION}"
    echo "------------------------------------------"

    # --- Phase 1: Binary Building ---
    echo "🏗️ Phase 1/2: Building Binaries..."

    # 1. macOS Binary
    if [ ! -d "dist/nandguard/mac/NANDGuard+.app" ]; then
        echo "🍎 Building macOS binary..."
        pyinstaller packaging/nandguard.spec --distpath dist/nandguard/mac --noconfirm > /dev/null 2>&1
    else
        echo "🍎 macOS binary already found in dist/nandguard/mac/"
    fi

    # 2. Linux Binary & Packaging
    echo "🐧 Building & Packaging for Linux..."
    if [[ "$OSTYPE" == "darwin"* ]] && command -v docker >/dev/null 2>&1; then
        echo "🐳 Docker detected. Building Linux .deb inside container..."
        docker build -t nandguard-builder-linux -f packaging/linux/Dockerfile . --quiet
        docker run --rm -v "$(pwd):/src" -e VERSION="$NEW_VERSION" nandguard-builder-linux
        if [ $? -eq 0 ]; then
            echo "✅ Linux DEB created in drivers/linux/"
        else
            echo "❌ Linux Docker build failed."
        fi
    else
        # Fallback to local build logic
        if [ ! -f "dist/nandguard/linux/NANDGuard+" ]; then
            echo "🐧 Building Linux binary locally..."
            pyinstaller packaging/nandguard.spec --distpath dist/nandguard/linux --noconfirm > /dev/null 2>&1
        fi
        
        if [ -f "dist/nandguard/linux/NANDGuard+" ]; then
            if command -v dpkg-deb >/dev/null 2>&1; then
                bash packaging/linux/build_deb.sh "$NEW_VERSION"
                echo "✅ Linux DEB created in drivers/linux/"
            else
                echo "⚠️  dpkg-deb not found. Zipping Linux binary instead..."
                mkdir -p drivers/linux
                zip -r "drivers/linux/nandguard-plus_linux_${NEW_VERSION}.zip" dist/nandguard/linux/ > /dev/null
                echo "✅ Linux ZIP created in drivers/linux/"
            fi
        else
            echo "❌ Linux binary missing. Skipping packaging."
        fi
    fi

    # 3. Windows Binary & Packaging
    echo "🪟 Building & Packaging for Windows..."
    if [[ "$OSTYPE" == "darwin"* ]] && command -v docker >/dev/null 2>&1; then
        echo "🐳 Docker detected. Building Windows .exe inside container..."
        docker build -t nandguard-builder-windows -f packaging/windows/Dockerfile . --quiet
        docker run --rm -v "$(pwd):/src" -e VERSION="$NEW_VERSION" nandguard-builder-windows
        if [ $? -eq 0 ]; then
            echo "✅ Windows EXE/ZIP created in drivers/windows/"
        else
            echo "❌ Windows Docker build failed."
        fi
    else
        # Fallback to local build logic
        if [ ! -d "dist/nandguard/windows/NANDGuard+" ]; then
            echo "🪟 Building Windows binary locally..."
            pyinstaller packaging/nandguard_windows.spec --distpath dist/nandguard/windows --noconfirm > /dev/null 2>&1
        fi

        if [ -d "dist/nandguard/windows/NANDGuard+" ]; then
            if command -v iscc >/dev/null 2>&1; then
                iscc /DAppVersion="$NEW_VERSION" packaging/windows/nandguard_installer.iss
                echo "✅ Windows EXE created in drivers/windows/"
            else
                echo "⚠️  Inno Setup (iscc) not found. Zipping Windows binary instead..."
                mkdir -p drivers/windows
                zip -r "drivers/windows/NANDGuard+_windows_${NEW_VERSION}.zip" dist/nandguard/windows/ > /dev/null
                echo "✅ Windows ZIP created in drivers/windows/"
            fi
        else
            echo "❌ Windows binary missing. Skipping packaging."
        fi
    fi

    # Update the version file only if at least one build step succeeded
    echo "$NEW_VERSION" > "$VERSION_FILE"
    echo "------------------------------------------"
    echo "✅ NANDGuard+ v${NEW_VERSION} Build Process Complete!"
    echo "------------------------------------------"
else
    echo "Usage: ./fkinstaller build nandguard"
    exit 1
fi
